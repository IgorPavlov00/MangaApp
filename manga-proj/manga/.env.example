# Copy to .env (never commit it) or set these in your host's dashboard.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys). Leave empty otherwise.
SUPABASE_JWT_SECRET=

# Supabase Postgres via the *Session pooler* (Connect -> Session pooler). It works over IPv4, which Render needs.
DATABASE_URL=jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR-PROJECT-REF
DATABASE_PASSWORD=your-database-password

# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://anime-manga-finder.netlify.app
